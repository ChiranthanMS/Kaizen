from fastapi import APIRouter, UploadFile, File, HTTPException, Depends
from typing import Optional
import time
import logging

from dependencies.auth_dependencies import get_current_user
from services.ocr_service import ocr_service
from services.gemini_service import gemini_service
from models.bill_ai_models import GeminiBillSchema

logger = logging.getLogger(__name__)

router = APIRouter(prefix="/ai-ocr", tags=["AI OCR Bills"]) 

@router.post("/analyze", response_model=dict)
async def analyze_bill(
    file: UploadFile = File(...),
    current_user = Depends(get_current_user),
):
    """
    Authenticated endpoint to upload a bill image/PDF, extract text via OCR, and analyze with Gemini.

    Steps:
    1) Validate file (type/size)
    2) Extract raw text using OCR service (OCR.space or EasyOCR fallback)
    3) Send text to Gemini with strict instructions
    4) Validate and normalize output with Pydantic (GeminiBillSchema)
    5) Return cleaned JSON
    """
    start = time.time()

    # 1) Validate file type and size
    allowed_extensions = {"jpg", "jpeg", "png", "bmp", "tiff", "gif", "pdf"}
    ext = (file.filename or "").lower().rsplit(".", 1)[-1]
    if ext not in allowed_extensions:
        raise HTTPException(status_code=400, detail=f"Unsupported file type. Allowed types: {', '.join(sorted(allowed_extensions))}")

    content = await file.read()
    if not content:
        raise HTTPException(status_code=400, detail="Empty file uploaded")
    if len(content) > 10 * 1024 * 1024:
        raise HTTPException(status_code=400, detail="File size too large. Maximum 10MB")

    # 2) OCR extraction
    success, raw_text, ocr_error = await ocr_service.extract_text_from_file(content, file.filename)
    if not success or not raw_text:
        raise HTTPException(status_code=400, detail=f"OCR failed: {ocr_error or 'no text extracted'}")

    # 3) Gemini analysis
    parsed, ai_error = gemini_service.analyze_bill(raw_text, filename=file.filename)
    if ai_error or not parsed:
        raise HTTPException(status_code=502, detail=f"Gemini error: {ai_error}")

    # 4) Pydantic validation (ensures keys/types and date format)
    try:
        validated = GeminiBillSchema(**parsed)
    except Exception as e:
        raise HTTPException(status_code=422, detail=f"Validation failed: {e}")

    # 5) Response
    elapsed = time.time() - start
    logger.info(f"AI OCR analyzed '{file.filename}' in {elapsed:.2f}s for user {getattr(current_user, 'email', 'unknown')}")

    return {
        "success": True,
        "filename": file.filename,
        "file_type": ext,
        "processing_time": elapsed,
        "raw_text_length": len(raw_text),
        "data": validated.dict(),
    }